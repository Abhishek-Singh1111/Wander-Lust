

<style>
  .error-shell {
    border-radius: 18px;
    padding: 2.5rem clamp(1.4rem, 3vw, 2.5rem);
    background: #fff;
    color: #0f172a;
  }

  .error-code {
    font-size: clamp(64px, 14vw, 120px);
    font-weight: 800;
    letter-spacing: -4px;
    margin: 0 0 0.25rem;
    line-height: 0.9;
  }

  .error-title {
    font-size: clamp(26px, 4vw, 36px);
    font-weight: 700;
    margin: 0 0 0.75rem;
  }

  .error-body {
    max-width: 34rem;
    font-size: 1.05rem;
    line-height: 1.6;
    color: #1f2937;
    margin-bottom: 1.1rem;
  }

  .error-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn-error-main,
  .btn-error-ghost {
    border: 1px solid #111;
    color: #0f172a;
    padding: 0.85rem 1.25rem;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 700;
    transition: transform 120ms ease, box-shadow 120ms ease;
  }

  .btn-error-main {
    background: #0f172a;
    color: #fff;
  }

  .btn-error-ghost {
    background: #fff;
  }

  .btn-error-main:hover,
  .btn-error-ghost:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    text-decoration: none;
    color: inherit;
  }
</style>

<div class="error-shell mt-4 mb-5">
  <p class="error-code"><%= statusCode || 404 %></p>
  <h1 class="error-title"><%= message || "Page not found" %></h1>
  <p class="error-body">
    We couldn't find that page. Try heading back to the listings or start fresh on the home page.
  </p>
  <div class="error-actions">
    <a class="btn-error-main" href="/listings">Browse listings</a>
  </div>
</div>
